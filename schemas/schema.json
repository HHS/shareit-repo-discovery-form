{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "SHARE IT Source Code Repository Discovery Form",
    "description": "<p>This intake form serves as a simple registry for gathering basic informtion about a source code repository. Responses will be used the agency to help repository managers and owners comply with the SHARE IT Act of 2024.</p>",
    "type": "object",
    "properties": {
        "items": {
            "Repository Name": {
                "type": "string",
                "description": "Name of the repository where the feedback is submitted"
            },
            "Repository URL": {
                "type": "string",
                "description": "URL of the repository where the feedback is submitted"
            },
            "Repository Type": {
                "type": "string",
                "description": "Type of repository where the feedback is submitted",
                "enum": [
                    "Source Code",
                    "Infrastructure-as-code",
                    "Scripts",
                    "Documentation",
                    "Other"
                ]
            },
            "Fisma System Identifier (if applicable)": {
                "type": "string",
                "description": "Fisma System Identifier (if applicable)"
            },
            "Repository Owner": {
                "type": "string",
                "description": "Name of the repository owner"
            },
            "Technical Custodian/Administrator": {
                "type": "string",
                "description": "Name of the technical custodian or administrator"
            },
            "Operational Status": {
                "type": "string",
                "description": "Operational status of the repository",
                "enum": [
                    "Active",
                    "Maintenance",
                    "Archived",
                    "Retired"
                ]
            },
            "Contractor-Operated": {
                "type": "string",
                "description": "Indicates if the repository is contractor-operated",
                "enum": [
                    "Yes",
                    "No"
                ]
            },
            "Last Updated": {
                "type": "string",
                "format": "date",
                "description": "Date when the repository was last updated"
            }
        }
    },
    "required": [
        "Repository Name",
        "Repository URL",
        "Repository Type",
        "Repository Owner",
        "Technical Custodian/Administrator",
        "Operational Status",
        "Contractor-Operated",
        "Last Updated"
    ]

}